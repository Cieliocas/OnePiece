# Copie para .env e preencha:  cp .env.example .env
# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Modelo do Gemini. O padrão do projeto é o gemini-3.5-flash.
# O gemini-2.5-flash não aceita mais chaves de projetos novos (erro 404) e será desligado em 01/12/2026.
GEMINI_MODEL=gemini-3.5-flash

# Opcionais (valores padrão já funcionam)
# GEMINI_THINKING_BUDGET=1024
# CACHE_TTL_SECONDS=3600
